    "audit": "node scripts/audit-source.cjs",
    "verify": "node scripts/verify.cjs"
  },
  "files": ["core/", "examples/", "docs/", "test/", "scripts/", "README.md", "README.en.md", "LICENSE", "THIRD_PARTY_NOTICES.md", "CHANGELOG.md", "source-files.json"]
}
